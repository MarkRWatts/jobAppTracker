// Job Application Tracker data model — see ../../jobAppTracker-docs/project-plan.md for background.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Source {
  LINKEDIN
  TOTAL_JOBS
  REED
  DIRECT
  OTHER
}

// A plain status list, not a strict state machine — real applications go
// sideways (a DISCOUNTED role can come back, a recruiter call can happen
// after an interview), so any status can be logged at any time.
enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  RECRUITER_CALL
  INTERVIEW
  OFFER
  ACCEPTED
  DISCOUNTED // rejected before/without reaching an interview
  UNSUCCESSFUL // rejected after at least one interview
  WITHDRAWN
}

enum AttachmentCategory {
  CV
  COVER_LETTER
  OTHER
}

enum EmploymentType {
  PERMANENT
  CONTRACT
}

// Only meaningful when employmentType is CONTRACT.
enum IR35Status {
  INSIDE
  OUTSIDE
  UNKNOWN
}

model Company {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  website      String?
  notes        String?
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  jobTitle    String
  source      Source
  jobUrl      String?
  jobDescription String?
  location    String?

  // salaryRange applies to PERMANENT roles; dayRate + ir35Status apply to
  // CONTRACT roles. Both are free text to match the loose formats job ads
  // actually use (ranges, "DOE", currency variations, etc).
  employmentType EmploymentType @default(PERMANENT)
  salaryRange    String?
  dayRate        String?
  ir35Status     IR35Status?

  // Denormalized from the latest StatusEvent, for fast board/list queries.
  currentStatus ApplicationStatus @default(SAVED)

  // Position within its board column. Initialized from the application date
  // (as epoch millis) so untouched columns read oldest-first by default;
  // manually reordering a column renumbers every card in it to small
  // sequential integers, which always sort before any still-timestamp-based
  // sibling, so the two schemes never need reconciling against each other.
  boardOrder Float @default(0)

  usedCustomCv    Boolean @default(false)
  cvVersionLabel  String?
  cvUrl           String?
  usedCoverLetter Boolean @default(false)
  coverLetterUrl  String?

  notes String?

  statusEvents StatusEvent[]
  contacts     Contact[]
  reminders    Reminder[]
  attachments  Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, currentStatus])
}

model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  // Free text for interview sub-stages, e.g. "Stage 2 — Technical".
  stageLabel    String?
  occurredAt    DateTime
  notes         String?
  createdAt     DateTime          @default(now())
}

model Contact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  role          String?
  email         String?
  phone         String?
  notes         String?
}

model Reminder {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dueAt         DateTime
  description   String
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// File bytes live on disk (see src/lib/attachments/storage.ts), keyed by
// `storedName` — a generated, filesystem-safe name, distinct from the
// human-facing `originalName` used for display/download.
model Attachment {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      AttachmentCategory
  originalName  String
  storedName    String             @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime           @default(now())
}

// --- Auth.js (@auth/prisma-adapter) models below — field names/types are ---
// --- part of the adapter's contract and must not be renamed.             ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts     Account[]
  sessions     Session[]
  companies    Company[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
