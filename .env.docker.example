# Copy to `.env.docker` next to docker-compose.yml, then pass
# `--env-file .env.docker` to every `docker compose` invocation. Deliberately
# NOT named `.env` — that name is reserved for the dev-server config
# (DATABASE_URL for `npm run dev`) and would collide with it.
#
# The `db` service is also used for local dev (Postgres in Docker, app run
# locally via `npm run dev`) — whatever password you set here must match the
# DATABASE_URL in your own `.env` (see .env.example).

POSTGRES_USER=jobapptracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobapptracker

# Auth.js — Sign in with Google. Same OAuth Client ID as .env.example, but
# with an additional authorized redirect URI registered for this port:
# http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID=change-me.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=change-me
# Generate with: openssl rand -base64 32 — must match .env's AUTH_SECRET if
# you want a session created via one to be valid on the other.
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3001
