# Local Postgres via the docker-compose `db` service (see docker-compose.yml
# and .env.docker.example — the password here must match POSTGRES_PASSWORD
# in your own .env.docker). Port 5433, not 5432 — this machine already runs
# a Homebrew Postgres on 5432 for the re:Fresh project.
DATABASE_URL="postgresql://jobapptracker:change-me@localhost:5433/jobapptracker?schema=public"

# Auth.js — Sign in with Google. Create an OAuth 2.0 Client ID (type: Web
# application) in Google Cloud Console > APIs & Services > Credentials, with
# an authorized redirect URI of http://localhost:3000/api/auth/callback/google
# (Google permits plain http:// on localhost — no HTTPS/tunnel needed here).
AUTH_GOOGLE_ID="change-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="change-me"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"
