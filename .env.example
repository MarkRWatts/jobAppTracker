# Local Postgres via the docker-compose `db` service (see docker-compose.yml
# and .env.docker.example — the password here must match POSTGRES_PASSWORD
# in your own .env.docker). Port 5433, not 5432 — this machine already runs
# a Homebrew Postgres on 5432 for the re:Fresh project.
DATABASE_URL="postgresql://jobapptracker:change-me@localhost:5433/jobapptracker?schema=public"
